# Bắt buộc khi service mở ra internet: token dùng chung với frontend.
# Sinh bằng: openssl rand -hex 32
# ANALYZER_TOKEN=

# Chỉ cần khi muốn gọi API trực tiếp từ browser lúc dev (bình thường đi qua Next.js)
# ALLOWED_ORIGINS=http://localhost:3000

