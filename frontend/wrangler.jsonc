{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Phải khớp tên Worker trên dashboard. Workers Builds deploy vào Worker mà
  // nó được gắn; nếu tên ở đây khác thì `npm run deploy` từ máy local sẽ tạo
  // ra một Worker thứ hai.
  "name": "cloudflare-nextjs-python",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Log thô + kết quả phân tích đã cache. Blob lớn -> R2.
  "r2_buckets": [
    {
      "binding": "LOGS",
      "bucket_name": "loglens-logs"
    },
    // App không dùng ISR nên binding này hiện không được đọc tới. Giữ vì
    // opennextjs-cloudflare deploy sẽ đòi đúng tên này nếu open-next.config
    // bật r2IncrementalCache — có sẵn thì deploy không bao giờ fail vì nó,
    // và sau này muốn bật ISR thì đã có chỗ.
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "loglens-logs"
    }
  ],

  // Metadata dataset. Query nhẹ, đọc nhiều -> D1.
  // database_id là DB thật trên Cloudflare; local dev bỏ qua nó và dùng
  // sqlite trong .wrangler/state.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loglens-db",
      "database_id": "57afc538-a1a1-49c2-a4e9-c628bd1190f9",
      "migrations_dir": "migrations"
    }
  ],

  // Bật Real-time Logs / Logs trên dashboard.
  "observability": { "enabled": true },

  "vars": {
    // Analyzer Python. Local dev là uvicorn ở cổng 8000; TRƯỚC KHI DEPLOY đổi
    // thành URL public của analyzer, ví dụ "https://analyzer.mien.vn".
    // Kiểm tra sau khi deploy bằng GET /api/health.
    "ANALYZER_URL": "http://localhost:8000",
    "MAX_UPLOAD_BYTES": "26214400"
  }

  // ANALYZER_TOKEN không đặt ở đây — file này được commit. Dùng:
  //   npx wrangler secret put ANALYZER_TOKEN
  // và local thì để trong .dev.vars
}
