{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Phải khớp tên Worker trên dashboard. Workers Builds deploy vào Worker mà
  // nó được gắn; nếu tên ở đây khác thì `npm run deploy` từ máy local sẽ tạo
  // ra một Worker thứ hai.
  "name": "frontend-nextjs-worker",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Tầng dữ liệu KHÔNG còn ở đây: R2 (LOGS) và D1 (DB) là binding của Worker
  // backend, xem backend/wrangler.jsonc. Worker này gọi backend qua service
  // binding ANALYZER bên dưới.
  //
  // Bucket dưới đây chỉ liên quan tới cache của OpenNext, không phải dữ liệu
  // app. App không dùng ISR nên hiện không được đọc tới; giữ vì
  // opennextjs-cloudflare deploy sẽ đòi đúng tên này nếu open-next.config bật
  // r2IncrementalCache — có sẵn thì deploy không bao giờ fail vì nó.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "loglens-logs"
    }
  ],

  // Nối sang Worker backend bằng service binding: request đi trong mạng
  // Cloudflare, không ra internet, không phụ thuộc URL workers.dev.
  //
  // Local dev cũng dùng đường này: `next dev` (getPlatformProxy) và
  // `opennextjs-cloudflare preview` đều nối được vào phiên `pywrangler dev`
  // của backend qua dev registry của wrangler — đã kiểm tra cả hai. Điều kiện
  // là backend đang chạy; không có binding thì lib/cf.ts rơi về ANALYZER_URL.
  "services": [
    {
      "binding": "ANALYZER",
      "service": "backend-python-worker"
    }
  ],

  // Bật Real-time Logs / Logs trên dashboard.
  "observability": { "enabled": true },

  "vars": {
    // Chỉ là đường dự phòng khi không có service binding ANALYZER ở trên —
    // ví dụ chạy frontend một mình, hoặc muốn trỏ sang analyzer ở nơi khác.
    // Khi deploy thì binding thắng, nên KHÔNG cần sửa thành URL workers.dev.
    // Kiểm tra bằng GET /api/health: bindings.backend_transport phải là
    // "service-binding".
    "ANALYZER_URL": "http://localhost:8000",
    "MAX_UPLOAD_BYTES": "26214400"
  }

  // ANALYZER_TOKEN không đặt ở đây — file này được commit. Dùng:
  //   npx wrangler secret put ANALYZER_TOKEN
  // và local thì để trong .dev.vars
}
